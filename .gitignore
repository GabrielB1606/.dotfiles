.env

# opencode keeps runtime state (service.json with credentials, node_modules,
# lockfiles, backups) next to its config, so only allowlisted files are tracked
opencode/.config/opencode/*
!opencode/.config/opencode/opencode.json
!opencode/.config/opencode/cli.json
!opencode/.config/opencode/tui.json
!opencode/.config/opencode/SKILLS.md
# Hermes skills symlink is created by setup-opencode.sh
opencode/.config/opencode/skills
